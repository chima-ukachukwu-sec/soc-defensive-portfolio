# Copy to .env and change every value. .env is gitignored.
# Generate secrets with: openssl rand -base64 32

BASE_URL=https://misp.internal.example
MYSQL_DATABASE=misp
MYSQL_USER=misp
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Only needed by the ingestion tool, not by the containers.
# MISP_KEY=
# OTX_API_KEY=
